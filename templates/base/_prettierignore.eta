node_modules
dist
coverage
<% if (it.config.framework === 'nextjs') { -%>
.next

# Written by create-next-app, in its own style. Reformatting them would mean
# fighting the framework over files it may rewrite.
eslint.config.mjs
postcss.config.mjs
<% } -%>
<% if (it.isPrisma) { -%>
prisma/migrations
<% } -%>

# Generated documentation. Prettier aligns markdown table pipes to the widest
# cell, which depends on values chosen at generation time, so a freshly
# generated project would fail its own format check. The content is prose;
# formatting it gains nothing.
README.md
<% if (it.config.aiDocumentation) { -%>
ARCHITECTURE.md
CONVENTIONS.md
AGENTS.md
<% } -%>
