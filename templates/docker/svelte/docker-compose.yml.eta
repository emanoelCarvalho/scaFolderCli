services:
  web:
    build:
      context: .
    environment:
      NODE_ENV: production
      PORT: <%= it.port %>
      # The API this client talks to. `host.docker.internal` reaches a server
      # running on your machine; point it at a real URL in any other setting.
      API_URL: ${API_URL:-http://host.docker.internal:3000}
      # SvelteKit's Node adapter needs to know its public origin to accept
      # form posts; a mismatch here is the usual cause of a 403 on submit.
      ORIGIN: ${ORIGIN:-http://localhost:<%= it.port %>}
<% if (it.hasAuth) { -%>
      SESSION_COOKIE_NAME: <%= it.dirName %>_session
<% } -%>
    ports:
      - '<%= it.port %>:<%= it.port %>'
    restart: unless-stopped
