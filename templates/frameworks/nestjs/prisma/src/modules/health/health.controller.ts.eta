import { Controller, Get, ServiceUnavailableException } from '@nestjs/common';
import { PrismaService } from '../../database/prisma.service';

interface LivenessResponse {
  status: 'ok';
  uptimeSeconds: number;
}

interface ReadinessResponse {
  status: 'ok';
  database: 'up';
}

/**
 * Liveness answers "is the process alive"; readiness answers "can it serve
 * traffic". They must mean different things: a database outage should stop
 * traffic being routed here, not restart the process.
 */
@Controller('health')
export class HealthController {
  constructor(private readonly prisma: PrismaService) {}

  @Get('live')
  live(): LivenessResponse {
    return { status: 'ok', uptimeSeconds: Math.round(process.uptime()) };
  }

  @Get('ready')
  async ready(): Promise<ReadinessResponse> {
    try {
      await this.prisma.$queryRaw`SELECT 1`;
    } catch {
      // The reason is deliberately not echoed back: it would leak connection
      // details. The failure is logged by the global exception filter.
      throw new ServiceUnavailableException('Database is not reachable');
    }
    return { status: 'ok', database: 'up' };
  }
}
