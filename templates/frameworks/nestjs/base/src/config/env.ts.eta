import { Type, plainToInstance } from 'class-transformer';
import {
  IsEnum,
  IsInt,
  IsOptional,
  IsString,
  Max,
  Min,
  MinLength,
  validateSync,
} from 'class-validator';

export enum NodeEnv {
  Development = 'development',
  Test = 'test',
  Production = 'production',
}

/**
 * Every environment variable the application reads. Nothing outside this class
 * touches `process.env`, so the full configuration surface is one file.
 */
export class Env {
  @IsEnum(NodeEnv)
  NODE_ENV: NodeEnv = NodeEnv.Development;

  @Type(() => Number)
  @IsInt()
  @Min(1)
  @Max(65535)
  PORT = <%= it.port %>;

  /** Comma-separated list of allowed origins, or `*` in development. */
  @IsString()
  CORS_ORIGIN = '*';
<% if (it.hasDatabase) { -%>

  @IsString()
  @MinLength(1)
  DATABASE_URL!: string;
<% } -%>
<% if (it.hasAuth) { -%>

  /**
   * Signing key for access tokens. Must be at least 32 characters: a short
   * secret is the weakest link in the whole authentication design.
   */
  @IsString()
  @MinLength(32)
  JWT_ACCESS_SECRET!: string;

  /** Access token lifetime, e.g. `15m`. Keep it short. */
  @IsString()
  JWT_ACCESS_TTL = '15m';

  /** Refresh token lifetime in days. Rotated on every use. */
  @Type(() => Number)
  @IsInt()
  @Min(1)
  JWT_REFRESH_TTL_DAYS = 30;
<% } -%>

  @IsOptional()
  @IsString()
  LOG_LEVEL?: string;
}

/**
 * Validates the environment at startup. The process refuses to boot when
 * configuration is missing or malformed — a misconfigured service must fail
 * immediately and loudly, not on the first request that needs the value.
 */
export function validateEnv(raw: Record<string, unknown>): Env {
  const env = plainToInstance(Env, raw, { enableImplicitConversion: true });
  const errors = validateSync(env, { skipMissingProperties: false, whitelist: false });

  if (errors.length > 0) {
    const details = errors
      .map((error) => `  - ${error.property}: ${Object.values(error.constraints ?? {}).join(', ')}`)
      .join('\n');
    throw new Error(`Invalid environment configuration:\n${details}`);
  }

  return env;
}
