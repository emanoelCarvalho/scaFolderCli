import 'server-only';
import { NextResponse } from 'next/server';
import { ApiError } from './api-error';

/**
 * Turns an error from the API into a response for our own client.
 *
 * Only messages the API chose to expose are forwarded; anything else becomes a
 * generic 500, so an internal failure here cannot leak through the browser.
 */
export function errorResponse(error: unknown): NextResponse {
  if (error instanceof ApiError) {
    return NextResponse.json(
      {
        message: error.message,
        ...(error.code ? { code: error.code } : {}),
        ...(error.details ? { details: error.details } : {}),
      },
      { status: error.status },
    );
  }

  console.error('Unexpected error in an auth route handler', error);
  return NextResponse.json({ message: 'Something went wrong' }, { status: 500 });
}

/** Reads and shape-checks a JSON body without trusting it. */
export async function readJson(request: Request): Promise<unknown> {
  try {
    return await request.json();
  } catch {
    return null;
  }
}
