import 'server-only';
import { cookies } from 'next/headers';
import { env } from '../env';

export interface Session {
  accessToken: string;
  refreshToken: string;
}

export interface SessionUser {
  id: string;
  email: string;
}

/** Thirty days, matching the refresh-token lifetime the API issues. */
const MAX_AGE_SECONDS = 30 * 24 * 60 * 60;

function refreshCookieName(): string {
  return `${env().SESSION_COOKIE_NAME}_refresh`;
}

/**
 * Tokens live in httpOnly cookies written by this application's route
 * handlers. Browser code cannot read them, which is the whole point — see
 * docs/adr/0009-nextjs-auth-bff.md.
 */
export async function setSession(session: Session): Promise<void> {
  const store = await cookies();
  const secure = env().NODE_ENV === 'production';

  const options = {
    httpOnly: true,
    secure,
    // `lax` still sends the cookie on top-level navigation back into the app,
    // which is what makes a normal sign-in redirect work.
    sameSite: 'lax' as const,
    path: '/',
    maxAge: MAX_AGE_SECONDS,
  };

  store.set(env().SESSION_COOKIE_NAME, session.accessToken, options);
  store.set(refreshCookieName(), session.refreshToken, options);
}

export async function clearSession(): Promise<void> {
  const store = await cookies();
  store.delete(env().SESSION_COOKIE_NAME);
  store.delete(refreshCookieName());
}

export async function getSession(): Promise<Session | null> {
  const store = await cookies();
  const accessToken = store.get(env().SESSION_COOKIE_NAME)?.value;
  const refreshToken = store.get(refreshCookieName())?.value;

  if (!accessToken || !refreshToken) return null;
  return { accessToken, refreshToken };
}

/** The access token, or null. Use when calling the API on the user's behalf. */
export async function getAccessToken(): Promise<string | null> {
  return (await getSession())?.accessToken ?? null;
}
