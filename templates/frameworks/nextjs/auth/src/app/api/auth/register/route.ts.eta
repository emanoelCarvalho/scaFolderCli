import { NextResponse } from 'next/server';
import { registerWithApi } from '@/lib/auth/auth-api';
import { credentialsSchema } from '@/lib/auth/schemas';
import { setSession } from '@/lib/auth/session';
import { errorResponse, readJson } from '@/lib/api/route-helpers';

export async function POST(request: Request): Promise<NextResponse> {
  const parsed = credentialsSchema.safeParse(await readJson(request));

  if (!parsed.success) {
    return NextResponse.json(
      {
        message: 'Check the form and try again',
        details: parsed.error.issues.map((issue) => ({
          path: issue.path.join('.'),
          message: issue.message,
        })),
      },
      { status: 400 },
    );
  }

  try {
    const { user, session } = await registerWithApi(parsed.data.email, parsed.data.password);
    await setSession(session);
    // Only the user is returned. The tokens stay in httpOnly cookies.
    return NextResponse.json({ user }, { status: 201 });
  } catch (error) {
    return errorResponse(error);
  }
}
