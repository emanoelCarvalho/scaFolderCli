import { NextResponse } from 'next/server';
import { refreshWithApi } from '@/lib/auth/auth-api';
import { clearSession, getSession, setSession } from '@/lib/auth/session';
import { errorResponse } from '@/lib/api/route-helpers';

/**
 * Rotates the session. The API invalidates the presented refresh token and
 * issues a new pair, which is written straight back into the cookies.
 */
export async function POST(): Promise<NextResponse> {
  const session = await getSession();
  if (!session) return NextResponse.json({ message: 'Not signed in' }, { status: 401 });

  try {
    const { user, session: rotated } = await refreshWithApi(session.refreshToken);
    await setSession(rotated);
    return NextResponse.json({ user });
  } catch (error) {
    // A refresh token the API rejects is dead. Keeping the cookie would leave
    // the user in a signed-in-looking state that never works again.
    await clearSession();
    return errorResponse(error);
  }
}
