import 'server-only';
import { z } from 'zod';

/**
 * Server-side configuration. Marked `server-only`, so importing this from a
 * client component is a build error rather than a leaked value at runtime.
 *
 * Nothing here is prefixed `NEXT_PUBLIC_`: none of it belongs in the browser.
 */
const envSchema = z.object({
  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),
  /** Base URL of the API this client talks to, without a trailing slash. */
  API_URL: z.string().url(),
<% if (it.hasAuth) { -%>
  /** Name of the cookie holding the access token. */
  SESSION_COOKIE_NAME: z.string().default('<%= it.dirName %>_session'),
<% } -%>
});

export type Env = z.infer<typeof envSchema>;

let cached: Env | undefined;

/**
 * Validates the environment on first use. The build and the first request fail
 * loudly when configuration is missing, rather than producing a page that
 * silently calls `undefined/api/...`.
 */
export function env(): Env {
  if (cached) return cached;

  const result = envSchema.safeParse(process.env);
  if (!result.success) {
    const details = result.error.issues
      .map((issue) => `  - ${issue.path.join('.')}: ${issue.message}`)
      .join('\n');
    throw new Error(`Invalid environment configuration:\n${details}`);
  }

  cached = result.data;
  return cached;
}
