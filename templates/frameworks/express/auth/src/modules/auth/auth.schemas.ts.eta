import { z } from 'zod';

/**
 * Every schema is strict: a property the schema does not declare is rejected
 * rather than silently dropped. A client sending a field we do not model is a
 * bug or an attack, never something to ignore.
 */
export const registerSchema = z
  .object({
    email: z.string().email().max(254),
    /**
     * Minimum 12 characters: length is the only password rule that reliably
     * increases strength. The maximum exists so that an enormous input cannot
     * be used to make the server spend seconds hashing it.
     */
    password: z.string().min(12, 'Password must be at least 12 characters').max(128),
  })
  .strict();

export const loginSchema = z
  .object({
    email: z.string().email().max(254),
    password: z.string().max(128),
  })
  .strict();

export const refreshSchema = z
  .object({
    refreshToken: z.string().min(1).max(512),
  })
  .strict();

export type RegisterInput = z.infer<typeof registerSchema>;
export type LoginInput = z.infer<typeof loginSchema>;
export type RefreshInput = z.infer<typeof refreshSchema>;
