import { z } from 'zod';

/**
 * Every environment variable the application reads. Nothing outside this file
 * touches `process.env`, so the full configuration surface is one schema.
 */
const envSchema = z.object({
  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),
  PORT: z.coerce.number().int().min(1).max(65535).default(<%= it.port %>),
  /** Comma-separated list of allowed origins, or `*` in development. */
  CORS_ORIGIN: z.string().default('*'),
  LOG_LEVEL: z.enum(['silent', 'fatal', 'error', 'warn', 'info', 'debug', 'trace']).default('info'),
<% if (it.hasDatabase) { -%>
  DATABASE_URL: z.string().min(1),
<% } -%>
<% if (it.hasAuth) { -%>
  /**
   * Signing key for access tokens. At least 32 characters: a short secret is
   * the weakest link in the whole authentication design.
   */
  JWT_ACCESS_SECRET: z.string().min(32),
  /** Access token lifetime, e.g. `15m`. Keep it short. */
  JWT_ACCESS_TTL: z.string().default('15m'),
  /** Refresh token lifetime in days. Rotated on every use. */
  JWT_REFRESH_TTL_DAYS: z.coerce.number().int().min(1).default(30),
<% } -%>
});

export type Env = z.infer<typeof envSchema>;

/**
 * Validates the environment at startup. The process refuses to boot when
 * configuration is missing or malformed — a misconfigured service must fail
 * immediately and loudly, not on the first request that needs the value.
 */
export function loadEnv(source: NodeJS.ProcessEnv = process.env): Env {
  const result = envSchema.safeParse(source);

  if (!result.success) {
    const details = result.error.issues
      .map((issue) => `  - ${issue.path.join('.')}: ${issue.message}`)
      .join('\n');
    throw new Error(`Invalid environment configuration:\n${details}`);
  }

  return result.data;
}
