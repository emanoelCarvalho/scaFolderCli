/**
 * Errors the domain is allowed to raise. HTTP status codes live in the error
 * middleware, not here: the domain does not know it is behind HTTP.
 */
export abstract class DomainError extends Error {
  abstract readonly code: string;

  constructor(message: string) {
    super(message);
    this.name = new.target.name;
  }
}

export class NotFoundError extends DomainError {
  readonly code = 'NOT_FOUND';
}

/** The request conflicts with current state, e.g. a duplicate unique value. */
export class ConflictError extends DomainError {
  readonly code = 'CONFLICT';
}

/** Authentication failed or was not supplied. */
export class UnauthorizedError extends DomainError {
  readonly code = 'UNAUTHORIZED';
}

/** The caller is authenticated but not allowed to do this. */
export class ForbiddenError extends DomainError {
  readonly code = 'FORBIDDEN';
}

/** Input was well-formed but violates a business rule. */
export class BusinessRuleError extends DomainError {
  readonly code = 'BUSINESS_RULE_VIOLATION';
}

/** Input failed schema validation. Carries the per-field detail. */
export class RequestValidationError extends DomainError {
  readonly code = 'VALIDATION_FAILED';

  constructor(
    message: string,
    readonly details: readonly { path: string; message: string }[],
  ) {
    super(message);
  }
}
