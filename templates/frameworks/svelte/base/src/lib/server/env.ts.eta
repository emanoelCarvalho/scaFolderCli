import { env as privateEnv } from '$env/dynamic/private';
import { z } from 'zod';

/**
 * Server-side configuration.
 *
 * Read through `$env/dynamic/private`, not `$env/static/private`: the values
 * then come from the process at run time, so one built image can be deployed to
 * any environment. SvelteKit refuses to import this module into client code.
 */
const envSchema = z.object({
	/** Base URL of the API this client talks to, without a trailing slash. */
	API_URL: z.string().url(),
<% if (it.hasAuth) { -%>
	/** Name of the cookie holding the session. */
	SESSION_COOKIE_NAME: z.string().default('<%= it.dirName %>_session')
<% } -%>
});

export type Env = z.infer<typeof envSchema>;

let cached: Env | undefined;

/**
 * Validates the environment on first use. The first request fails loudly when
 * configuration is missing, rather than serving a page that quietly calls
 * `undefined/auth/login`.
 */
export function env(): Env {
	if (cached) return cached;

	const result = envSchema.safeParse(privateEnv);
	if (!result.success) {
		const details = result.error.issues
			.map((issue) => `  - ${issue.path.join('.')}: ${issue.message}`)
			.join('\n');
		throw new Error(`Invalid environment configuration:\n${details}`);
	}

	cached = result.data;
	return cached;
}
