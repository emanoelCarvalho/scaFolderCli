<script lang="ts">
	interface Props {
		/** Null renders an empty live region, which is what keeps it announceable. */
		message?: string | null;
		tone?: 'info' | 'success' | 'error';
	}

	let { message = null, tone = 'info' }: Props = $props();

	const tones = {
		info: 'border-black/15 dark:border-white/20',
		success: 'border-green-600 text-green-700 dark:text-green-400',
		error: 'border-red-600 text-red-700 dark:text-red-400'
	};
</script>

<!--
	The live region is always in the DOM. Inserting the region and its text at
	the same moment means screen readers announce nothing.
-->
<div
	aria-live="polite"
	class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex justify-center px-4"
>
	{#if message}
		<div
			class="pointer-events-auto w-full max-w-sm rounded-md border bg-white px-4 py-3 text-sm shadow-lg dark:bg-neutral-900 {tones[
				tone
			]}"
		>
			{message}
		</div>
	{/if}
</div>
