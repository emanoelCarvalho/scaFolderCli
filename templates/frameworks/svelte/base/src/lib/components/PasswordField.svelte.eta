<script lang="ts">
	import type { HTMLInputAttributes } from 'svelte/elements';

	interface Props extends Omit<HTMLInputAttributes, 'id' | 'type'> {
		label: string;
		error?: string;
		hint?: string;
	}

	let { label, error, hint, ...rest }: Props = $props();

	let visible = $state(false);

	const id = $props.id();
	const hintId = `${id}-hint`;
	const errorId = `${id}-error`;
	// `$derived`, not a plain const: `error` arrives after a failed submit, and a
	// captured initial value would leave aria-describedby pointing at nothing —
	// the message would render but never be announced with the field.
	const describedBy = $derived(
		[hint ? hintId : null, error ? errorId : null].filter(Boolean).join(' ')
	);
</script>

<div class="flex flex-col gap-1.5">
	<label for={id} class="text-sm font-medium">{label}</label>
	<div class="relative">
		<input
			{...rest}
			{id}
			type={visible ? 'text' : 'password'}
			aria-invalid={error ? 'true' : undefined}
			aria-describedby={describedBy || undefined}
			class="w-full rounded-md border bg-transparent px-3 py-2 pr-16 text-sm transition outline-none focus:ring-2 focus:ring-black/20 dark:focus:ring-white/30 {error
				? 'border-red-500'
				: 'border-black/15 dark:border-white/20'}"
		/>
		<!-- A real button, so it is reachable by keyboard; the label names the
		     action rather than the state. -->
		<button
			type="button"
			onclick={() => (visible = !visible)}
			class="absolute inset-y-0 right-0 px-3 text-xs font-medium opacity-70 hover:opacity-100"
		>
			{visible ? 'Hide' : 'Show'}
		</button>
	</div>
	{#if hint && !error}
		<p id={hintId} class="text-xs opacity-60">{hint}</p>
	{/if}
	{#if error}
		<p id={errorId} role="alert" class="text-xs text-red-600">{error}</p>
	{/if}
</div>
