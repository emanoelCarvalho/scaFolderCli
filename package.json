{
  "name": "scafoldercli",
  "version": "0.1.0",
  "description": "Opinionated project scaffolder for Node.js/TypeScript: framework + architecture + conventions + tooling + infrastructure + AI documentation.",
  "keywords": [
    "scaffold",
    "generator",
    "cli",
    "nestjs",
    "express",
    "nextjs",
    "svelte",
    "typescript",
    "boilerplate"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "scafoldercli": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "prepack": "npm run clean && npm run build",
    "test:all": "vitest run",
    "verify:full": "npm run verify && npm run test:integration",
    "test:golden": "vitest run tests/integration/nestjs-golden.test.ts tests/integration/express-golden.test.ts tests/integration/nextjs-golden.test.ts",
    "test:package": "vitest run tests/integration/package.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "eta": "^4.6.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
